{
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "separate-pull-requests": true,
  "always-update": true,
  "changelog-sections": [
    {"type": "feat", "section": "Features"},
    {"type": "fix", "section": "Bug Fixes"},
    {"type": "perf", "section": "Performance Improvements"},
    {"type": "revert", "section": "Reverts"},
    {"type": "docs", "section": "Documentation"},
    {"type": "chore", "section": "Miscellaneous Chores", "hidden": true},
    {"type": "style", "section": "Styles", "hidden": true},
    {"type": "refactor", "section": "Code Refactoring", "hidden": true},
    {"type": "test", "section": "Tests", "hidden": true},
    {"type": "build", "section": "Build System", "hidden": true},
    {"type": "ci", "section": "Continuous Integration", "hidden": true}
  ],
  "packages": {
    "models/h7-bulb-storage": {
      "release-type": "simple",
      "component": "h7-bulb-storage",
      "include-component-in-tag": true,
      "pull-request-header": ":service_dog: I have created a release \\*bark\\* \\*woof\\*"
    },
    "models/fire-extinguisher-rattlinator": {
      "release-type": "simple",
      "component": "fire-extinguisher-rattlinator",
      "include-component-in-tag": true,
      "pull-request-header": ":service_dog: I have created a release \\*bark\\* \\*woof\\*"
    },
    "models/h8-h9-h11-h16-bulb-storage": {
      "release-type": "simple",
      "component": "h8-h9-h11-h16-bulb-storage",
      "include-component-in-tag": true,
      "pull-request-header": ":service_dog: I have created a release \\*bark\\* \\*woof\\*"
    }
  }
}
